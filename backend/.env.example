APP_NAME="Integra NIR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Banco de dados: PostgreSQL ─────────────────────────────────────────────
# Combina com o docker-compose.yml da raiz do projeto.
# Em produção, troque pelos dados do banco da empresa.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=integra_nir
DB_USERNAME=integra
DB_PASSWORD=integra

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ── Frontend (CORS) ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── AGHU (sistema hospitalar que fornece os dados do paciente) ─────────────
# AGHU_MOCK=true  → usa pacientes de demonstração (não precisa do AGHU real)
# AGHU_MOCK=false → consulta a API real em AGHU_BASE_URL com AGHU_TOKEN
AGHU_MOCK=true
AGHU_BASE_URL=
AGHU_TOKEN=
AGHU_TIMEOUT=5

# ── Swagger (documentação em /api/documentation) ───────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
